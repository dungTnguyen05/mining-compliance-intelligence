{
  "name": "mining-compliance-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for mining compliance intelligence",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
